# 本地配置模板。
# 复制为 configs/config.local.yaml 后，再通过 CONFIG_FILE 指向它。
# 启动前请替换所有 change-me 和 JWT PEM 占位内容。

app:
  env: local

logging:
  log_level: info
  log_add_source: false

http:
  addr: ":8080"

postgres:
  dsn: "postgres://postgres:postgres@127.0.0.1:5432/cixing?sslmode=disable"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

oss:
  bucket: "memento"
  region: ""                                      # 本地开发可不填，SDK 自动查询
  access_key_id: ""
  access_key_secret: ""
  public_endpoint: "https://memento.muxixyz.com"  # 七牛云 CDN 加速域名
  put_presign_expire: 15m
  get_presign_expire: 10m
  upload_prefix: "test/"                          # 本地开发用 test/ 前缀隔离
  styles:
    card_4x3:      "imageView2/1/w/900/h/1200|imageMogr2/auto-orient/quality/85/format/webp"
    square_small:  "imageView2/1/w/320/h/320|imageMogr2/auto-orient/quality/82/format/webp"
    square_medium: "imageView2/1/w/640/h/640|imageMogr2/auto-orient/quality/85/format/webp"
    detail_large:  "imageMogr2/auto-orient/quality/88/format/webp"

jwt:
  private_key_pem: |-
    -----BEGIN PRIVATE KEY-----
    change-me
    -----END PRIVATE KEY-----
  public_key_pem: |-
    -----BEGIN PUBLIC KEY-----
    change-me
    -----END PUBLIC KEY-----

auth:
  hash_pepper: "change-me"

email:
  addr: "127.0.0.1:1025"
  username: ""
  password: ""
  from: "no-reply@cixing.local"
  reply_to: ""
  use_tls: false
